<?xml version="1.0" encoding="UTF-8"?>
  <configuration>
    <system.webServer>
      <rewrite>
        <rules>
          <clear />

          <!-- Dejar que la aplicación ASP.NET Core /api la procese IIS -->
          <rule name="DoNotProxyApi" stopProcessing="true">
            <match url="^api(?:/.*)?$" />
            <action type="None" />
          </rule>

          <!-- Todo lo demás se envía al servidor Angular SSR -->
          <rule name="ReverseProxyToAngularSSR" stopProcessing="true">
            <match url="(.*)" />
            <!-- Node solo ve Host: 127.0.0.1:4000; le pasamos el dominio público para que Angular SSR
                 arme URLs/SEO correctas. Requiere permitirlas una vez en el servidor:
                 appcmd set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_X_FORWARDED_HOST']" /+"[name='HTTP_X_FORWARDED_PROTO']" /commit:apphost -->
            <serverVariables>
              <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
              <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            </serverVariables>
            <action
              type="Rewrite"
              url="http://127.0.0.1:4000/{R:1}"
              appendQueryString="true"
            />
          </rule>
        </rules>
      </rewrite>

      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </configuration>